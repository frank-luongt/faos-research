        "definition": "Ratio of non-performing loans (Groups 3-5 per TT11) to total outstanding loans",
        "healthy_range": "< 3%",
        "world_class": "< 1.5%",
        "regulatory_reference": "SBV Circular 11/2021"
      },
      "car": {
        "definition": "Capital Adequacy Ratio: (Tier 1 + Tier 2) / RWA; minimum 8%",
        "healthy_range": "≥ 10%",
        "minimum": "8%",
        "formula": "(Tier 1 Capital + Tier 2 Capital) / Risk-Weighted Assets",
        "regulatory_reference": "SBV Circular 22/2019"
      },
      "lcr": {
        "definition": "Liquidity Coverage Ratio: HQLA / 30-day net outflows; minimum 100%",
        "minimum": "100%",
        "healthy_range": "> 120%",
        "regulatory_reference": "SBV Circular 22/2019"
      },
      "nim": {
        "definition": "Net Interest Margin: net interest income / average earning assets",
